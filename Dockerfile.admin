FROM node:24.18.0-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/api-client-ts/package.json packages/api-client-ts/package.json
RUN npm ci

FROM node:24.18.0-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN npm run build --workspace=@rehla/admin

FROM node:24.18.0-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S -g 10001 rehla && adduser -S -u 10001 -G rehla rehla
COPY --from=build --chown=rehla:rehla /app/apps/admin/.next/standalone ./
COPY --from=build --chown=rehla:rehla /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build --chown=rehla:rehla /app/apps/admin/public ./apps/admin/public
USER 10001
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/admin/server.js"]
