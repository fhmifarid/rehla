REHLA_ENV=local
REHLA_SERVICE_NAME=rehla-api
REHLA_HTTP_ADDR=:58080
REHLA_DATABASE_URL=postgres://rehla:rehla_local_only@localhost:55432/rehla?sslmode=disable
REHLA_DATABASE_MAX_CONNS=20
REHLA_DATABASE_MIN_CONNS=2
REHLA_DATABASE_CONNECT_TIMEOUT=5s
REHLA_LOG_LEVEL=info
REHLA_LOG_FORMAT=json
REHLA_SHUTDOWN_TIMEOUT=15s
REHLA_READ_TIMEOUT=10s
REHLA_WRITE_TIMEOUT=30s
REHLA_IDLE_TIMEOUT=60s
REHLA_WORKER_POLL_INTERVAL=2s
REHLA_WORKER_BATCH_SIZE=50
REHLA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:53000

NEXT_PUBLIC_API_BASE_URL=http://localhost:58080

POSTGRES_DB=rehla
POSTGRES_USER=rehla
POSTGRES_PASSWORD=rehla_local_only
POSTGRES_PORT=55432
API_PORT=58080
ADMIN_PORT=53000
MINIO_ROOT_USER=rehla
MINIO_ROOT_PASSWORD=rehla_local_only_change_me
